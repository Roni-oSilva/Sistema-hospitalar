# Copie para deploy/env/api.env (fora do git) e preencha. Ver docs/ENVIRONMENT.md.
APP_ENV=production
PORT=4000
# Usuário de MENOR privilégio (só DML), criado por deploy/sql/app-role.sql — NÃO o dono do banco
DATABASE_URL=postgresql://hospital_app:SENHA_DO_APP@db:5432/hospital_production?schema=public
WEB_ORIGIN=https://atendimento.hospital-ulianopolis.example
COOKIE_SECURE=true
TRUST_PROXY=1
HOSPITAL_TIMEZONE=America/Belem
LOG_LEVEL=info
# Chave do painel de TV (gere com: openssl rand -hex 24). A TV abre /painel-chamada?key=...
PUBLIC_PANEL_KEY=
