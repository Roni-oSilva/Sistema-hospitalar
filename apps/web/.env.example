# Web (Next.js) — exemplo. Copie para apps/web/.env.local em desenvolvimento.
# Para onde o Next encaminha /api em DESENVOLVIMENTO (em produção o Nginx faz isso). Avaliado no build.
API_INTERNAL_URL=http://localhost:4000
# Socket.IO: em desenvolvimento aponte para a API; em produção deixe VAZIO (mesma origem via Nginx). Avaliado no build.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_HOSPITAL_TIMEZONE=America/Belem
