# API — exemplo de configuração. Copie para apps/api/.env (desenvolvimento) e ajuste.
# NUNCA versione o arquivo .env real. Em staging/produção, use variáveis de ambiente do servidor/orquestrador.
# Documentação completa: docs/ENVIRONMENT.md

# development | test | staging | production  (cada um com SEU banco — a API recusa combinações perigosas)
APP_ENV=development
PORT=4000

# Banco do ambiente. O nome do banco deve refletir o ambiente (ex.: hospital_dev, hospital_staging, hospital_production)
DATABASE_URL=postgresql://hospital:TROQUE_ESTA_SENHA@localhost:5432/hospital_dev?schema=public

# Origem(ns) do frontend, separadas por vírgula (CORS + verificação anti-CSRF)
WEB_ORIGIN=http://localhost:3000

# Em produção/staging é true por padrão (HTTPS obrigatório). Em desenvolvimento local (http), false.
COOKIE_SECURE=false

# Quantos proxies reversos confiar (Nginx na frente = 1)
TRUST_PROXY=0

HOSPITAL_TIMEZONE=America/Belem
LOG_LEVEL=info

# Opcional: exige ?key=... no painel público de chamada (TV). Recomendado em produção. Mínimo 16 caracteres.
PUBLIC_PANEL_KEY=

# Opcionais (padrões seguros já definidos no código)
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
# RATE_LIMIT_PER_MINUTE=900
# LOGIN_RATE_LIMIT_PER_MINUTE=20

# Somente desenvolvimento: senha dos usuários do seed (padrão: Desenvolvimento2026)
# SEED_DEV_PASSWORD=
